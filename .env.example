API_ID=
API_HASH=
BOT_TOKEN=
ADMIN_ID=xxxx
DUMP_CHANNEL_ID=-100xxxxxxxxxx

LOG_LEVEL=info# trace, debug, info, warn, error

# Database configuration:
# Local development uses embedded PGlite by default (zero setup, stored in ./bot-data/db)
# DATABASE_DIR=./bot-data/db
#
# Production PostgreSQL (uncomment and set to connect to PostgreSQL):
# DATABASE_URL=postgres://user:password@localhost:5432/alac_bot

# Mirror & Fallback Decryption Engine:
# ALAC_MIRROR_URL=https://custom-mirror.example.com
# ALAC_API_KEY=your_key_here
#
# Fallback wrapper engine (defaults to local wrapper at http://127.0.0.1:12340):
# When primary mirror is down or times out, bot automatically switches to this URL.
# You can swap this with any local or remote link in the future.
ALAC_WRAPPER_URL=http://127.0.0.1:12340
# ALAC_WRAPPER_API_KEY=

# Retries & Exponential Backoff:
# ALAC_MAX_RETRIES=3
# ALAC_RETRY_BASE_MS=2000
