{
  "name": "alac-bot",
  "license": "MIT",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun ./src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "bun --watch ./src/main.ts",
    "start": "bun ./src/main.ts"
  },
  "dependencies": {
    "@bcheidemann/tracing": "npm:@jsr/bcheidemann__tracing",
    "@mtcute/bun": "^0.32.1",
    "@mtcute/dispatcher": "^0.32.1",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@electric-sql/pglite": "^0.5.8",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
